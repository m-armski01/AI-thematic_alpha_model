# Data cache (re-downloadable) and generated outputs. Per run (outputs/<run.name>/) the report,
# data-quality report and figures ARE committed so the README renders on GitHub, as are the
# study report and its figures; everything else under outputs/ is not.
data/cache/
!data/cache/.gitkeep
outputs/*
!outputs/.gitkeep
!outputs/study.md
!outputs/*/
outputs/*/*
!outputs/*/report.md
!outputs/*/data_quality.md
!outputs/*/figures/
outputs/*/figures/*
!outputs/*/figures/*.png
!outputs/study/*.png
!outputs/study/*.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
.env

# OS
.DS_Store

# Local tooling and private notes (never published)
.claude/
private/
